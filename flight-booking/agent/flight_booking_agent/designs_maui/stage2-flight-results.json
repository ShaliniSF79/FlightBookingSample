[
  {
    "version": "v0.9",
    "createSurface": {
      "surfaceId": "workspace",
      "catalogId": "syncfusion-maui"
    }
  },
  {
    "version": "v0.9",
    "updateComponents": {
      "surfaceId": "workspace",
      "components": [
        {
          "id": "root",
          "component": "Column",
          "gap": 16,
          "children": [
            "title",
            "summaryCard",
            "resultsCard"
          ],
          "padding": 24
        },
        {
          "id": "title",
          "component": "Text",
          "text": "Flight Results",
          "variant": "h2"
        },
        {
          "id": "summaryCard",
          "component": "SyncfusionCardView",
          "content": "summaryText",
          "cornerRadius": 16,
          "borderWidth": 1,
          "borderColor": "#e2e8f0"
        },
        {
          "id": "summaryText",
          "component": "Text",
          "text": {
            "path": "/summaryText"
          }
        },
        {
          "id": "resultsCard",
          "component": "SyncfusionCardView",
          "content": "resultsCol",
          "cornerRadius": 16,
          "borderWidth": 1,
          "borderColor": "#e2e8f0"
        },
        {
          "id": "resultsCol",
          "component": "Column",
          "gap": 8,
          "children": [
            "flightsGrid",
            "hint",
            "bookBtn"
          ]
        },
        {
          "id": "hint",
          "component": "Text",
          "text": "Tap a flight row, then press Book now.",
          "variant": "caption"
        },
        {
          "id": "bookBtn",
          "component": "SyncfusionButton",
          "text": "Book now →",
          "background": "#2563eb",
          "textColor": "#ffffff",
          "cornerRadius": 12,
          "fontAttributes": "Bold",
          "onClick": {
            "event": {
              "name": "selectFlightAndProceed",
              "context": {
                "selectedRow": {
                  "path": "/selectedFlight"
                },
                "stage1": {
                  "path": "/stage1"
                },
                "passengers": {
                  "path": "/stage1/passengers"
                },
                "results": {
                  "path": "/filteredFlights"
                },
                "activeStep": 1,
                "nextStep": 2
              }
            }
          }
        },
        {
          "id": "flightsGrid",
          "component": "SyncfusionDataGrid",
          "dataSource": {
            "path": "/filteredFlights"
          },
          "columns": [
            {
              "field": "airline",
              "headerText": "Airline",
              "width": 140.0
            },
            {
              "field": "flight",
              "headerText": "Flight",
              "width": 110.0
            },
            {
              "field": "departure",
              "headerText": "Departure",
              "width": 150.0
            },
            {
              "field": "arrival",
              "headerText": "Arrival",
              "width": 150.0
            },
            {
              "field": "duration",
              "headerText": "Duration",
              "width": 110.0
            },
            {
              "field": "stops",
              "headerText": "Stops",
              "width": 100.0
            },
            {
              "field": "baggage",
              "headerText": "Baggage",
              "width": 120.0
            },
            {
              "field": "rating",
              "headerText": "Rating",
              "width": 90.0,
              "textAlign": "end"
            },
            {
              "field": "price",
              "headerText": "Price",
              "width": 110.0,
              "textAlign": "end",
              "format": "C0"
            },
            {
              "field": "action",
              "headerText": "Book now",
              "width": 130.0
            }
          ],
          "sortingMode": "single",
          "selectionMode": "single",
          "onRowClick": {
            "event": {
              "name": "select",
              "context": {}
            }
          },
          "selectedRowJson": {
            "path": "/selectedFlight"
          },
          "height": 360
        }
      ]
    }
  },
